<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>BlockCount</RootNamespace>
    <AssemblyName>BlockCount</AssemblyName>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <StaticWebAssetBasePath>App_Plugins/BlockCount</StaticWebAssetBasePath>
    <PackageId>BlockCount</PackageId>
    <Version>13.1.0</Version>
    <Authors>Farshadudheen k</Authors>
    <Description>Add powerful validation rules to Umbraco Block List content, helping editors ensure blocks meet your content requirements before publishing.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>umbraco;umbraco-marketplace;block-list;block-grid</PackageTags>
    <IsPackable>true</IsPackable>
    <Title>BlockCount</Title>
    <Copyright>Copyright © BlockCount contributors</Copyright>
    <PackageProjectUrl>https://github.com/farshadudheen/blockcount</PackageProjectUrl>
    <RepositoryUrl>https://github.com/farshadudheen/blockcount</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>icon.png</PackageIcon>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Web.Common" Version="[13.0.0, 14.0.0)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\assets\icon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
